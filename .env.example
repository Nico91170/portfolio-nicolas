# ==============================================================================
# VARIABLES D'ENVIRONNEMENT - PORTFOLIO NICOLAS PIRES DE JESUS
# ==============================================================================
# Copiez ce fichier sous le nom ".env.local" pour le développement local,
# ou renseignez ces variables dans les "Environment Variables" de votre projet Vercel.

# ------------------------------------------------------------------------------
# 1. EXPÉDITION D'E-MAILS VIA RESEND (Recommandé - Gratuit jusqu'à 3000 emails/mois)
# Inscription sur https://resend.com (aucun numéro de CB requis)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Adresse email d'envoi (si domaine vérifié) ou par défaut le bac à sable Resend :
RESEND_FROM=Portfolio Nicolas <onboarding@resend.dev>

# Adresse email qui réceptionne les messages envoyés depuis le portfolio
CONTACT_EMAIL=nicolas.piresdejesus91170@gmail.com

# ------------------------------------------------------------------------------
# 2. ALTERNATIVE : FORMSPREE (Optionnel, si vous préférez Formspree)
# Inscription sur https://formspree.io
# ------------------------------------------------------------------------------
# FORMSPREE_ID=xpwzqab
# FORMSPREE_ENDPOINT=https://formspree.io/f/xpwzqab

# ------------------------------------------------------------------------------
# 3. NOTIFICATION INSTANTANÉE DISCORD WEBHOOK (Optionnel)
# Créez un webhook dans les paramètres de votre salon Discord pour recevoir
# une alerte immédiate sur votre smartphone à chaque message de recruteur.
# ------------------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdefghij
